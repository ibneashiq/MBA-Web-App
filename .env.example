# Google Cloud Service Account (Base64-encoded JSON key file)
# Scopes needed: Google Drive API & Google Sheets API
GOOGLE_SERVICE_ACCOUNT=

# Google Spreadsheet ID for storing report data (from the URL: docs.google.com/spreadsheets/d/<ID>/edit)
# Must contain sheets/tabs: "main", "sections", "images"
REPORTS_SPREADSHEET_ID=

# Google Drive Folder ID to store uploaded report images (from drive.google.com/drive/folders/<FOLDER_ID>)
# Make sure to share this folder with your Service Account as Editor!
GOOGLE_DRIVE_FOLDER_ID=

# (Optional) External upload endpoint (e.g. Apps Script URL). If omitted, uploads directly via Service Account.
IMAGE_UPLOAD_ENDPOINT=

# Optional: Google Spreadsheet ID for custom default values/dropdowns (falls back to built-in template ID)
DEFAULTS_SPREADSHEET_ID=
